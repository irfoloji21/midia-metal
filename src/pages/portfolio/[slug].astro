---
export const prerender = false;
/**
 * portfolio/[slug].astro — Portfolio detail page (PURE ASTRO, SSR)
 *
 * Server-rendered: fetches fresh portfolio data on every request.
 * No getStaticPaths — the slug comes from the URL at request time.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getApiBase } from '@/lib/api-base';
import { buildBreadcrumbJsonLd } from '@/lib/seo';
import portfolioImageAlt from '@/data/portfolio-image-alt.json';

const siteUrl = import.meta.env.SITE;
const API = `${getApiBase()}/v1`;
const imageAltByUrl: Record<string, string> = portfolioImageAlt;

const { slug } = Astro.params;

// Cache headers: CDN caches for 10 min
Astro.response.headers.set('Cache-Control', 'public, s-maxage=600, stale-while-revalidate=3600');

// Fetch project detail at request time
let project: any = null;
let related: any[] = [];

try {
  const detailRes = await fetch(`${API}/portfolio/${slug}`);
  if (detailRes.ok) {
    project = await detailRes.json();
  }

  // Fetch related projects from same category
  if (project?.portfolio_category?.slug) {
    const relRes = await fetch(`${API}/portfolio?category=${project.portfolio_category.slug}`);
    if (relRes.ok) {
      const relData = await relRes.json();
      related = (relData || []).filter((p: any) => p.slug !== slug).slice(0, 3);
    }
  }
} catch (e) {
  console.error('Failed to fetch portfolio data:', e);
}

// 404 if project not found
if (!project) {
  return Astro.redirect('/404');
}
---

<BaseLayout
  title={project?.title || 'Project'}
  description={`${project?.title || 'Project'} - A portfolio project by Midia M Metal showcasing our commercial kitchen and fabrication work.`}
  canonicalPath={`/portfolio/${slug}`}
  structuredData={[buildBreadcrumbJsonLd([
    { name: 'Home', url: `${siteUrl}/` },
    { name: 'Portfolio', url: `${siteUrl}/portfolio` },
    { name: project?.title || 'Project', url: `${siteUrl}/portfolio/${slug}` },
  ])]}
>
  <div class="min-h-screen bg-[#eaf0f3]">
    {project ? (
      <>
        <section class="container mx-auto px-4 lg:px-8 pt-16 md:pt-24 pb-14 md:pb-20">
          <div class="grid grid-cols-1 xl:grid-cols-[minmax(0,68fr)_minmax(0,32fr)] gap-8 xl:gap-10 items-start [&>*]:min-w-0 [overflow-wrap:anywhere]">
            <div>
              <Image src={project.image} alt={imageAltByUrl[project.image] || project.title} width={800} height={600} loading="eager" decoding="async" class="w-full h-auto md:h-[520px] object-contain bg-[#f4f5f7]" />

              <p class="mt-8 text-[10px] font-bold uppercase tracking-[0.22em] text-muted-foreground">{project.portfolio_category?.name || "Uncategorized"}</p>
              <h1 class="font-sans text-[42px] md:text-[58px] leading-[0.95] font-semibold text-[#10275c] mt-3 mb-6">{project.title}</h1>

              <p class="text-[15px] text-[#58657f] leading-8 mb-6 whitespace-pre-wrap">
                {project.description || "No description provided."}
              </p>

              {project.gallery && project.gallery.length > 0 && (
                <div class={`grid grid-cols-1 ${project.gallery.length >= 2 ? 'md:grid-cols-2' : ''} gap-4 mb-8`}>
                  {project.gallery.map((imgUrl: string, index: number) => (
                    <Image src={imgUrl} alt={imageAltByUrl[imgUrl] || `${project.title} - additional project view ${index + 1}`} width={600} height={400} loading="lazy" decoding="async" class="w-full h-auto md:h-[280px] object-contain bg-[#f4f5f7]" />
                  ))}
                </div>
              )}
            </div>

            <aside class="bg-[#f4f5f7] p-8">
              <h3 class="font-sans text-[30px] leading-none font-semibold text-primary mb-8">Project Info</h3>
            <div class="space-y-5 text-[15px] text-[#58657f]">
                {project.client && <div class="flex items-start gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#2f9cea] mt-1"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                  <p>
                    <span class="text-primary font-semibold">Client:</span> {project.client}
                  </p>
                </div>}
                {project.customer_number && <div class="flex items-start gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#2f9cea] mt-1"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.2 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.96.35 1.9.7 2.8a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.35 1.84.58 2.8.7A2 2 0 0 1 22 16.92z"/></svg>
                  <p>
                    <span class="text-primary font-semibold">Client Phone:</span>{" "}
                    {project.customer_number ? <a href={`tel:${project.customer_number}`} class="hover:text-primary">{project.customer_number}</a> : "N/A"}
                  </p>
                </div>}
                {project.year && <div class="flex items-start gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#2f9cea] mt-1"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
                  <p>
                    <span class="text-primary font-semibold">Year:</span> {project.year}
                  </p>
                </div>}
                <p><span class="text-primary font-semibold">Category:</span> {project.portfolio_category?.name || "Uncategorized"}</p>
              </div>

              {project.services_list && project.services_list.length > 0 && (
                <>
                  <h4 class="font-sans text-[24px] leading-none font-semibold text-primary mt-10 mb-4">Services</h4>
                  <ul class="space-y-2">
                    {project.services_list.map((service: string) => (
                       <li class="text-[14px] text-[#58657f]">
                        - {service}
                      </li>
                    ))}
                  </ul>
                </>
              )}

              <a
                href="/contact"
                class="mt-10 inline-flex items-center justify-center h-12 px-8 w-full bg-orange text-white text-[14px] font-semibold hover:bg-orange-hover transition-colors"
              >
                Start Your Project Brief
              </a>
            </aside>
          </div>
        </section>

        {related.length > 0 && (
          <section class="container mx-auto px-4 lg:px-8 pb-24">
            <h3 class="font-sans text-[38px] md:text-[50px] leading-none font-semibold text-[#10275c] mb-8">Related Projects</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {related.map((item: any) => (
                <a href={`/portfolio/${item.slug}`} class="group">
                  <div class="mb-4 overflow-hidden">
                    <Image src={item.image} alt={item.title} width={600} height={400} loading="lazy" decoding="async" class="w-full h-[240px] object-cover transition-transform duration-300 group-hover:scale-105" />
                  </div>
                  <h4 class="font-sans text-[20px] font-semibold text-orange">{item.title}</h4>
                  <p class="text-[14px] text-[#58657f] mt-1">{item.portfolio_category?.name || "Uncategorized"}</p>
                </a>
              ))}
            </div>
          </section>
        )}
      </>
    ) : (
      <section class="container mx-auto px-4 lg:px-8 py-20 text-center">
        <h1 class="font-sans text-[44px] font-semibold text-[#10275c] mb-4">Project Not Found</h1>
        <a href="/portfolio" class="text-orange underline">
          Back to portfolio
        </a>
      </section>
    )}
  </div>
</BaseLayout>
