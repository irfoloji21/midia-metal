---
/**
 * contact.astro — Contact page (PURE ASTRO + ContactForm island)
 *
 * Pattern:
 *   1. Fetch settings in frontmatter
 *   2. Render static contact info (address, phone, email) as pure Astro
 *   3. Mount ContactForm island for the interactive form
 *   4. Render Google Maps iframe as static HTML
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactForm from '@/islands/ContactForm';
import { buildBreadcrumbJsonLd } from '@/lib/seo';
import { fetchSettings, getPageTitle, getPageDescription } from '@/lib/settings';

const siteUrl = import.meta.env.SITE;

// --- Data Fetching (runs for each server request) ---
const settings = await fetchSettings({ bypassCache: true });

const t = (key: string, def: string) => settings[key] || def;
const contactPhone = t('contact_phone', '');
const contactEmail = t('contact_email', '');
---

<BaseLayout
  title={getPageTitle(settings, 'contact_meta_title', 'Contact Midia M Metal | Kitchen Equipment & Fabrication')}
  description={getPageDescription(settings, 'contact_meta_description', 'Contact Midia M Metal for kitchen equipment, bespoke fabrication, ventilation systems, canopies and wall cladding. Our factory is in London.')}
  canonicalPath="/contact"
  structuredData={[buildBreadcrumbJsonLd([
    { name: 'Home', url: `${siteUrl}/` },
    { name: 'Contact', url: `${siteUrl}/contact` },
  ])]}
>
  <div class="min-h-screen bg-[#eaf0f3]">
    <section class="container mx-auto px-4 lg:px-8 pt-16 md:pt-20 pb-14 md:pb-20">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 md:gap-16">
        <!-- Static Contact Info -->
        <div>
          <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-[#10275c] mb-5">{t("contact_hero_label", "Contact Midia M Metal")}</p>
          <h1 class="font-sans text-[38px] md:text-[52px] leading-[1.05] font-semibold text-[#10275c] mb-6 whitespace-pre-line">
            {t("contact_hero_title", "Product and project enquiries.")}
          </h1>
          <p class="text-[#58657f] text-[16px] leading-8 max-w-[560px] mb-6 whitespace-pre-line">
            {t("contact_welcome", "Contact Midia M Metal for enquiries about commercial kitchen equipment, fabrication and installation.")}
          </p>
          <div class="flex flex-wrap gap-3 mb-10">
            {contactPhone && (
              <a href={`tel:${contactPhone.replace(/\s/g, '')}`} class="inline-flex items-center justify-center px-7 py-3 bg-orange text-white text-sm font-semibold hover:bg-orange-hover transition-colors">
                {t('contact_phone_label', 'Call Us')}
              </a>
            )}
          </div>

          <div class="space-y-5 text-[#58657f] text-[16px]">
            <div class="flex items-start gap-4">
              <!-- MapPin icon -->
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#2f9cea] mt-1 flex-shrink-0"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              <p>{t("contact_address", "")}</p>
            </div>
            <div class="flex items-start gap-4">
              <!-- Phone icon -->
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#2f9cea] mt-1 flex-shrink-0"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <a href={`tel:${contactPhone.replace(/\s/g, '')}`} class="text-[#10275c] text-[28px] md:text-[39px] leading-none font-medium hover:text-orange transition-colors">{contactPhone}</a>
            </div>
            <div class="flex items-start gap-4">
              <!-- Mail icon -->
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#2f9cea] mt-1 flex-shrink-0"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              <a href={`mailto:${contactEmail}`} class="break-all hover:text-orange transition-colors">{contactEmail}</a>
            </div>
          </div>
          <div class="mt-10 border-t border-[#c7d0de] pt-6">
            <h2 class="font-sans text-[24px] font-semibold text-primary mb-2">{t('contact_quote_title', 'Request a quotation.')}</h2>
            <p class="text-sm leading-7 text-[#58657f] mb-3">{t('contact_quote_desc', 'For project pricing, use our quotation form to submit your requirements and supporting files.')}</p>
            <a href="/get-a-quote" class="text-sm font-semibold text-primary underline underline-offset-4 hover:text-orange transition-colors">{t('contact_quote_button_label', 'Request a Quote')}</a>
          </div>
        </div>

        <!-- Contact Form Island -->
        <div>
          <h2 class="font-sans text-[28px] md:text-[34px] leading-tight font-semibold text-primary mb-4">{t('contact_form_title', 'Send an enquiry.')}</h2>
          <p class="text-sm leading-7 text-[#58657f] mb-8">{t('contact_form_intro', 'Use this form for product questions and general enquiries.')}</p>
          <ContactForm
            client:idle
            messagePlaceholder={t("contact_form_message_placeholder", "Enter your message.")}
            buttonLabel={t("contact_form_button_label", "Send Enquiry")}
            copy={{
              nameLabel: t('contact_form_name_label', 'Full Name'),
              emailLabel: t('contact_form_email_label', 'Email Address'),
              phoneLabel: t('contact_form_phone_label', 'Phone Number (optional)'),
              subjectLabel: t('contact_form_subject_label', 'Enquiry Subject (optional)'),
              sendingLabel: t('contact_form_sending_label', 'Sending...'),
              successMessage: t('contact_form_success_message', 'Your enquiry has been received. Our team will review the details and contact you using the information provided.'),
              errorMessage: t('contact_form_error_message', 'Your enquiry could not be sent. Please try again or contact us by phone or email.'),
              privacyError: t('contact_form_privacy_error', 'Please confirm your agreement to the privacy policy before sending your enquiry.'),
              privacyPrefix: t('contact_form_privacy_prefix', 'I agree to the'),
              privacyLinkLabel: t('contact_form_privacy_link_label', 'Privacy Policy.'),
            }}
          />
        </div>
      </div>
    </section>

    <!-- Google Maps -->
    <section class="w-full h-[460px] md:h-[620px]">
      <iframe
        src={t("contact_map_url", "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d158858.18237282!2d-0.24168049!3d51.52855825!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47d8a00baf21de75%3A0x52963a5addd52a99!2sLondon%2C%20UK!5e0!3m2!1sen!2sus!4v1709000000000!5m2!1sen!2sus")}
        width="100%"
        height="100%"
        style="border: 0;"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Location Map"
      ></iframe>
    </section>
  </div>
</BaseLayout>
