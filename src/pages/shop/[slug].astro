---
export const prerender = false;
/**
 * shop/[slug].astro — Product detail page (SSR)
 *
 * Server-rendered: fetches fresh product + related data on every request.
 * This ensures prices, stock, and reviews are always current.
 *
 * SEO: Product JSON-LD for rich snippets + breadcrumbs.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductDetailIsland from '@/islands/ProductDetailIsland';
import { getApiBase } from '@/lib/api-base';
import { fetchPublicJson, PublicApiError } from '@/lib/public-api';
import { getStandardizedDisplayPrice, parseMoneyValue } from '@/lib/pricing';
import { stripHtml, truncateText, buildBreadcrumbJsonLd, buildProductJsonLd } from '@/lib/seo';

const siteUrl = import.meta.env.SITE;
const API = `${getApiBase()}/v1`;
const { slug } = Astro.params;

// Cache headers: CDN caches for 5 min, serves stale while revalidating for 1 hour
Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=3600');

// Fetch product detail + related products in parallel at request time
let product: any = null;
let related: any[] = [];
let productUnavailable = false;

const [productResult, relatedResult] = await Promise.allSettled([
  fetchPublicJson<any>(`${API}/products/${slug}`),
  fetchPublicJson<any[]>(`${API}/products/${slug}/related`),
]);
if (productResult.status === 'fulfilled') {
  if (productResult.value && typeof productResult.value === 'object' && !Array.isArray(productResult.value)) product = productResult.value;
  else productUnavailable = true;
} else if (!(productResult.reason instanceof PublicApiError && productResult.reason.status === 404)) {
  productUnavailable = true;
  console.error('[shop/slug] Product data is temporarily unavailable.');
}
if (relatedResult.status === 'fulfilled' && Array.isArray(relatedResult.value)) related = relatedResult.value.slice(0, 3);

// 404 if product not found
if (!product && !productUnavailable) {
  return Astro.redirect('/404');
}
if (productUnavailable) {
  Astro.response.status = 503;
  Astro.response.headers.set('Cache-Control', 'no-store');
  Astro.response.headers.set('Retry-After', '30');
}

// Dynamic SEO from product data
const productName = product?.name || 'Product';
const productPrice = product ? getStandardizedDisplayPrice(product) : '';
const pageTitle = productPrice ? `${productName} - ${productPrice}` : productName;
const rawDescription = product?.description || '';
const pageDescription = rawDescription
  ? truncateText(stripHtml(rawDescription), 155)
  : `View ${productName} details from Midia M Metal.`;

// Product JSON-LD for rich snippets in Google Search
const productUrl = `${siteUrl}/shop/${slug}`;
const numericPrice = product?.price_on_request ? null : parseMoneyValue(productPrice);
const productJsonLd = buildProductJsonLd({
  name: productName,
  description: rawDescription,
  image: product?.image,
  sku: product?.product_code || product?.sku || String(product?.id || ''),
  brand: product?.specifications?.Manufacturer || product?.specifications?.Brand || 'Midia M Metal',
  url: productUrl,
  price: numericPrice,
  availability: product?.stock > 0 || product?.in_stock !== false
    ? 'https://schema.org/InStock'
    : 'https://schema.org/OutOfStock',
  ratingValue: product?.average_rating,
  reviewCount: product?.review_count,
});

const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  { name: 'Home', url: `${siteUrl}/` },
  { name: 'Shop', url: `${siteUrl}/shop` },
  ...(product?.category ? [{ name: product.category.name || product.category, url: `${siteUrl}/shop/category/${product.category.slug || ''}` }] : []),
  { name: productName, url: productUrl },
]);
---

<BaseLayout
  title={productUnavailable ? 'Product temporarily unavailable' : pageTitle}
  description={pageDescription}
  image={product?.image}
  canonicalPath={`/shop/${slug}`}
  noindex={productUnavailable}
  structuredData={productUnavailable ? [] : [productJsonLd, breadcrumbJsonLd]}
>
  <div class="min-h-screen bg-[#eaf0f3]">
    {productUnavailable ? (
      <section class="container mx-auto px-4 py-20 text-center max-w-2xl">
        <h1 class="font-sans text-3xl font-semibold text-primary mb-5">This product is temporarily unavailable.</h1>
        <p class="text-[#58657f] leading-7 mb-8">We could not load the product details. Please try again in a moment.</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href={Astro.url.pathname} class="bg-orange text-white px-7 py-3 rounded-md font-semibold hover:bg-orange-hover">Try again</a>
          <a href="/shop" class="border border-primary text-primary px-7 py-3 rounded-md font-semibold">Browse products</a>
        </div>
      </section>
    ) : <ProductDetailIsland
      id={slug!}
      initialProduct={product}
      initialRelated={related}
      client:load
    />}
  </div>
</BaseLayout>
