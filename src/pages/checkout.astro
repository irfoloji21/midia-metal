---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CheckoutIsland from '@/islands/CheckoutIsland';
---

<BaseLayout
  title="Checkout"
  description="Complete your checkout securely."
  canonicalPath="/checkout"
  noindex
>
  <div class="min-h-screen bg-[#eaf0f3]">
    <h1 class="container mx-auto px-4 lg:px-8 pt-8 font-sans text-3xl font-semibold text-primary">Checkout</h1>
    <CheckoutIsland client:load />
  </div>
</BaseLayout>
