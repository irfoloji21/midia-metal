---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import AccountIsland from '@/islands/AccountIsland';
---

<BaseLayout
  title="My Account"
  description="Manage your orders, quotes, and saved details."
  canonicalPath="/account"
  noindex
>
  <div class="min-h-screen bg-[#eaf0f3]">
    <h1 class="container mx-auto px-4 lg:px-8 pt-8 font-sans text-3xl font-semibold text-primary">My Account</h1>
    <AccountIsland client:only="react" />
  </div>
</BaseLayout>
