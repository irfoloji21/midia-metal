---
/**
 * BaseLayout.astro — Main layout for all public Astro pages.
 *
 * Features:
 *   - ViewTransitions for SPA-like page transitions (no full reload)
 *   - transition:persist on Header/Footer to keep islands alive across navigations
 *   - Prefetching enabled via astro.config.mjs
 *   - SEO: Open Graph, Twitter Cards, structured data, canonical URLs
 *   - Optimized font loading (preconnect + swap, no render-blocking @import)
 */
import { ViewTransitions } from 'astro:transitions';
import HeaderIsland from '@/islands/HeaderIsland';
import CustomerSessionIsland from '@/islands/CustomerSessionIsland';
import FooterIsland from '@/islands/FooterIsland';
import CookieBannerIsland from '@/islands/CookieBannerIsland';
import ToasterIsland from '@/islands/ToasterIsland';
import { fetchSettings } from '@/lib/settings';
import 'sonner/dist/styles.css';
import '@/index.css';
import '@/content-sections.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalPath?: string;
  noindex?: boolean;
  structuredData?: object[];
}

const layoutSettings = await fetchSettings();
const siteName = layoutSettings.site_name || 'Midia M Metal';
const siteLogo = layoutSettings.site_logo || '/logo.png';

const {
  title = `${siteName} | Commercial Kitchen Ventilation & Fabrication`,
  description = 'Commercial kitchen equipment, stainless steel fabrication, ventilation systems and canopy installation. Our factory is in London.',
  image = siteLogo,
  canonicalPath,
  noindex = false,
  structuredData = [],
} = Astro.props;

const siteUrl = import.meta.env.SITE;
const fullTitle = title.includes(siteName) || title.includes(' | ') ? title : `${title} | ${siteName}`;
const canonicalUrl = canonicalPath ? `${siteUrl}${canonicalPath}` : undefined;
const safeImage = typeof image === 'string' && image.trim().length > 0 ? image.trim() : '/logo.png';
const normalizedOgImagePath = safeImage.startsWith('/') ? safeImage : `/${safeImage}`;
const ogImage = safeImage.startsWith('http') ? safeImage : `${siteUrl}${normalizedOgImagePath}`;

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteName} />
    <meta name="theme-color" content="#10275c" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href={siteLogo} />

    <!-- DNS Prefetch for backend API (images served from /storage) -->
    <link rel="dns-prefetch" href="https://midiammetal.com" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@midiametal" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Google Fonts (preload + async swap: non-render-blocking) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&family=Playfair+Display:wght@400;500;600;700&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&family=Playfair+Display:wght@400;500;600;700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&family=Playfair+Display:wght@400;500;600;700&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- View Transitions: SPA-like navigation without full page reloads -->
    <ViewTransitions />

    <!-- Structured Data -->
    {structuredData.map((data) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}
  </head>
  <body class="bg-background text-foreground font-sans">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:bg-primary focus:px-4 focus:py-3 focus:text-sm focus:font-semibold focus:text-white"
    >
      Skip to main content
    </a>
    <!-- transition:persist keeps these islands alive across page navigations -->
    <CustomerSessionIsland client:load transition:persist />
    <HeaderIsland initialSettings={layoutSettings} client:idle transition:persist />
    <main id="main-content">
      <slot />
    </main>
      <FooterIsland initialSettings={layoutSettings} client:load transition:persist />
    <CookieBannerIsland client:idle transition:persist />
    <ToasterIsland client:idle transition:persist />
  </body>
</html>
